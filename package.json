{
  "name": "skillseekr",
  "version": "0.1.0",
  "description": "Resolve skill registries for AI coding agents: CLI and stdio MCP server",
  "type": "module",
  "bin": {
    "skillseekr": "dist/cli/main.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "assets",
    "plugins",
    ".claude-plugin"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "commander": "15.1.0",
    "jsonc-parser": "3.3.1",
    "tar": "7.5.23",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.18.0"
}
